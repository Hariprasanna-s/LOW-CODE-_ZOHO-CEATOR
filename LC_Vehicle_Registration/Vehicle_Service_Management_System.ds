 application "Vehicle Service Management System"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "America/Los_Angeles"
 	time format = "24-hr"

 	forms
	{
		form service_bay
		{
			displayname = "Service Bay"
			success message = "Service Bay Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			bay_name
			(
    			type = text
				displayname = "Bay Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			capacity
			(
				type = number
				displayname = "Capacity"
				maxchar = 19
	 			row = 1
	 			column = 1   
				width = medium
			)
			current_status
			(
				type = picklist
				displayname = "Current Status"
				values = {"Occupied","Available","Maintenance"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			assigned_request
			(
				type = list	
				displayname = "Assigned Request"
				values  = service_request.ID
    			displayformat = [request_id]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			maintenance_schedule
			(
    			type = textarea
				displayname = "Maintenance Schedule"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			last_maintenance_date
			(
    			type = date
				displayname = "Last Maintenance Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			next_maintenance_date
			(
    			type = date
				displayname = "Next Maintenance Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			bay_type
			(
				type = picklist
				displayname = "Bay Type"
				values = {"Heavy Duty","Standard","Specialized"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			notes
			(
    			type = textarea
				displayname = "Notes"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form service_request
		{
			displayname = "Service Request"
			success message = "Service Request Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			request_id
			(
    			type = text
				displayname = "Request Id"
	 			row = 1
	 			column = 1   
				width = medium
			)
			owner_name
			(
    			type = name
				displayname = "Owner Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
	     			 visibility = false
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			vehicle_registration_number
			(
    			type = text
				displayname = "Vehicle Registration Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			vehicle_type
			(
				type = picklist
				displayname = "Vehicle Type"
				values = {"Van","SUV","Pickup","Coupe","Hatchback","Sedan","MUV","Other"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			email_address
			(
    			type = email
				displayname = "Email Address"
	 			row = 1
	 			column = 1   
				width = medium
			)
			contact_number
			(
    			type = phonenumber
				displayname = "Contact Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			pickup_address
			(
    			type = address
				displayname = "Pickup Address"
     			capture_coordinates = true
     			adjust_using_map = false
     			address_line_1
     			(
	     			  type = address_line_1
	     			  displayname = "Address Line 1"
     			) 
     			address_line_2
     			(
	     			  type = address_line_2
	     			  displayname = "Address Line 2"
	     			 visibility = false
     			) 
     			district_city
     			(
	     			  type = district_city
	     			  displayname = "City / District"
	     			 visibility = false
     			) 
     			state_province
     			(
	     			  type = state_province
	     			  displayname = "State / Province"
	     			 visibility = false
     			) 
     			postal_Code
     			(
	     			  type = postal_Code
	     			  displayname = "Postal Code"
	     			 visibility = false
     			) 
     			country
     			(
	     			  type = country
	     			  displayname = "Country"
	     			 visibility = false
     			) 
     			latitude
     			(
	     			  type = latitude
	     			  displayname = "Latitude"
	     			 visibility = false
     			) 
     			longitude
     			(
	     			  type = longitude
	     			  displayname = "Longitude"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			odometer_reading
			(
				type = number
				displayname = "Odometer Reading"
				maxchar = 19
	 			row = 1
	 			column = 1   
				width = medium
			)
			service_type
			(
				type = picklist
				displayname = "Service Type"
				values = {"Breakdown Repair","Accident Repair","Routine Service"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			additional_services_requested
			(
				type = list	
				displayname = "Additional Services Requested"
				values = {"Wheel Alignment","Tyre Rotation","Oil Change","Car Wash","Interior Cleaning","AC Service"}
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			issue_description
			(
    			type = textarea
				displayname = "Issue Description"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			preferred_service_date
			(
    			type = date
				displayname = "Preferred Service Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			preferred_dropoff_time
			(
    			type = time
				displayname = "Preferred Dropoff Time"
				timedisplayoptions = "hh:mm:ss" 
	 			row = 1
	 			column = 1   
				width = medium
			)
			authorize_estimate_and_repair
			(
    			type = checkbox
				displayname = "Authorize Estimate And Repair"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
			status
			(
				type = picklist
				displayname = "Status"
				values = {"Requested","In Diagnosis","Delivered","In Repair","Ready for Pickup"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			diagnosis_status
			(
				type = picklist
				displayname = "Diagnosis Status"
				values = {"Completed","In Progress","Pending"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			repair_status
			(
				type = picklist
				displayname = "Repair Status"
				values = {"Completed","In Progress","Pending"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			ready_for_pickup_status
			(
				type = picklist
				displayname = "Ready For Pickup Status"
				values = {"Ready","Notified","Not Ready"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			assigned_technician
			(
    			type = text
				displayname = "Assigned Technician"
	 			row = 1
	 			column = 1   
				width = medium
			)
			assigned_service_bay
			(
    			type = text
				displayname = "Assigned Service Bay"
	 			row = 1
	 			column = 1   
				width = medium
			)
			estimated_cost
			(
				displayname = "Estimated Cost"
				type = USD
	 			row = 1
	 			column = 1   
				width = medium
			)
			actual_cost
			(
				displayname = "Actual Cost"
				type = USD
	 			row = 1
	 			column = 1   
				width = medium
			)
			insurance_document
			(
    			type = text
				displayname = "Insurance Document"
	 			row = 1
	 			column = 1   
				width = medium
			)
			damage_photos
			(
    			type = text
				displayname = "Damage Photos"
	 			row = 1
	 			column = 1   
				width = medium
			)
			submitted_on
			(
    			type = datetime
				displayname = "Submitted On"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			last_status_updated
			(
    			type = datetime
				displayname = "Last Status Updated"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Service Request Received","Initial Assessment","Request Rejected","Diagnosis Required","Diagnosis Completed","Estimate Generation","Awaiting Approval","Repair Scheduled","Repair In Progress","Repair Completed","Quality Assurance Check","Ready for Pickup","Vehicle Delivered","Service Request Closed"}
			}
		}
		form technician_profile
		{
			displayname = "Technician Profile"
			success message = "Technician Profile Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			technician_name
			(
    			type = name
				displayname = "Technician Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
	     			 visibility = false
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			employee_id
			(
    			type = text
				displayname = "Employee Id"
	 			row = 1
	 			column = 1   
				width = medium
			)
			specialization
			(
				type = picklist
				displayname = "Specialization"
				values = {"Bodywork","General","Electrical","Engine","Tire"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			phone_number
			(
    			type = phonenumber
				displayname = "Phone Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			email_address
			(
    			type = email
				displayname = "Email Address"
	 			row = 1
	 			column = 1   
				width = medium
			)
			current_status
			(
				type = picklist
				displayname = "Current Status"
				values = {"In Service","On Leave","Available"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			assigned_bay
			(
    			type = text
				displayname = "Assigned Bay"
	 			row = 1
	 			column = 1   
				width = medium
			)
			hire_date
			(
    			type = date
				displayname = "Hire Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			hourly_rate
			(
				displayname = "Hourly Rate"
				type = USD
	 			row = 1
	 			column = 1   
				width = medium
			)
			notes
			(
    			type = textarea
				displayname = "Notes"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
	}
	reports
	{
		list service_bay_Report
		{
			displayName = "All Service Bays"
			show all rows from service_bay    
			(
				bay_name as "Bay Name"
				capacity as "Capacity"
				current_status as "Current Status"
				assigned_request as "Assigned Request"
				maintenance_schedule as "Maintenance Schedule"
				last_maintenance_date as "Last Maintenance Date"
				next_maintenance_date as "Next Maintenance Date"
				bay_type as "Bay Type"
				notes as "Notes"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (current_status == "Available")
				fields = [current_status]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (current_status == "Maintenance")
				fields = [current_status]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (current_status == "Occupied")
				fields = [current_status]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
			)
		}
		kanban service_bay_by_current_status
		{
			displayName = "Current Statuses"
			show all rows from service_bay    
			(
				bay_name as "Bay Name"
				capacity as "Capacity"
				current_status as "Current Status"
				assigned_request as "Assigned Request"
				maintenance_schedule as "Maintenance Schedule"
				last_maintenance_date as "Last Maintenance Date"
				next_maintenance_date as "Next Maintenance Date"
				bay_type as "Bay Type"
				notes as "Notes"
			)
			options
			(
	 			display field = current_status
	 		)
		}
		list technician_profile_Report
		{
			displayName = "All Technician Profiles"
			show all rows from technician_profile    
			(
				technician_name  as "Technician Name"
				employee_id as "Employee Id"
				specialization as "Specialization"
				phone_number as "Phone Number"
				email_address as "Email Address"
				current_status as "Current Status"
				assigned_bay as "Assigned Bay"
				hire_date as "Hire Date"
				hourly_rate as "Hourly Rate"
				(
					display = total,average,min,max	
				)
				notes as "Notes"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (specialization == "Bodywork")
				fields = [specialization]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (specialization == "Engine")
				fields = [specialization]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (specialization == "Tire")
				fields = [specialization]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
			)
		}
		kanban technician_profile_by_specialization
		{
			displayName = "Specializations"
			show all rows from technician_profile    
			(
				technician_name  as "Technician Name"
				employee_id as "Employee Id"
				specialization as "Specialization"
				phone_number as "Phone Number"
				email_address as "Email Address"
				current_status as "Current Status"
				assigned_bay as "Assigned Bay"
				hire_date as "Hire Date"
				hourly_rate as "Hourly Rate"
				(
					display = total,average,min,max	
				)
				notes as "Notes"
			)
			options
			(
	 			display field = specialization
	 		)
		}
		list service_request_Report
		{
			displayName = "All Service Requests"
			show all rows from service_request    
			(
				request_id as "Request Id"
				owner_name  as "Owner Name"
				vehicle_registration_number as "Vehicle Registration Number"
				vehicle_type as "Vehicle Type"
				email_address as "Email Address"
				contact_number as "Contact Number"
				pickup_address  as "Pickup Address"
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				odometer_reading as "Odometer Reading"
				service_type as "Service Type"
				additional_services_requested as "Additional Services Requested"
				issue_description as "Issue Description"
				preferred_service_date as "Preferred Service Date"
				preferred_dropoff_time as "Preferred Dropoff Time"
				authorize_estimate_and_repair as "Authorize Estimate And Repair"
				status as "Status"
				diagnosis_status as "Diagnosis Status"
				repair_status as "Repair Status"
				ready_for_pickup_status as "Ready For Pickup Status"
				assigned_technician as "Assigned Technician"
				assigned_service_bay as "Assigned Service Bay"
				estimated_cost as "Estimated Cost"
				(
					display = total,average,min,max	
				)
				actual_cost as "Actual Cost"
				(
					display = total,average,min,max	
				)
				insurance_document as "Insurance Document"
				damage_photos as "Damage Photos"
				submitted_on as "Submitted On"
				last_status_updated as "Last Status Updated"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (service_type == "Accident Repair")
				fields = [service_type]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (service_type == "Breakdown Repair")
				fields = [service_type]
				format = "color:#000000;background-color:#1bbc9b;"
				}
			)
		}
		kanban service_request_by_vehicle_type
		{
			displayName = "Vehicle Types"
			show all rows from service_request    
			(
				request_id as "Request Id"
				owner_name  as "Owner Name"
				vehicle_registration_number as "Vehicle Registration Number"
				vehicle_type as "Vehicle Type"
				email_address as "Email Address"
				contact_number as "Contact Number"
				pickup_address  as "Pickup Address"
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				odometer_reading as "Odometer Reading"
				service_type as "Service Type"
				additional_services_requested as "Additional Services Requested"
				issue_description as "Issue Description"
				preferred_service_date as "Preferred Service Date"
				preferred_dropoff_time as "Preferred Dropoff Time"
				authorize_estimate_and_repair as "Authorize Estimate And Repair"
				status as "Status"
				diagnosis_status as "Diagnosis Status"
				repair_status as "Repair Status"
				ready_for_pickup_status as "Ready For Pickup Status"
				assigned_technician as "Assigned Technician"
				assigned_service_bay as "Assigned Service Bay"
				estimated_cost as "Estimated Cost"
				(
					display = total,average,min,max	
				)
				actual_cost as "Actual Cost"
				(
					display = total,average,min,max	
				)
				insurance_document as "Insurance Document"
				damage_photos as "Damage Photos"
				submitted_on as "Submitted On"
				last_status_updated as "Last Status Updated"
			)
			options
			(
	 			display field = vehicle_type
	 		)
		}
	}
	pages
	{
		page DashBoard
