		workflow
		{
		form
		{
			auto_assign_technician as "Auto-Assign Technician on Request"
			{
				type =  form
				form = service_request

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Fetch the current vehicle type from input
										vehicleType = input.vehicle_type;
										// Fetch all technicians with status 'Available'
										availableTechnicians = technician_profile[current_status == "Available"];
										// Initialize variables for matching technician
										matchedTechnician = null;
										specializationMap = {"Breakdown Repair":"General","Accident Repair":"Bodywork","Routine Service":"General"};
										// Determine required specialization based on service type
										requiredSpecialization = "";
										if(input.service_type == "Breakdown Repair")
										{
											requiredSpecialization = "General";
										}
										else if(input.service_type == "Accident Repair")
										{
											requiredSpecialization = "Bodywork";
										}
										else if(input.service_type == "Routine Service")
										{
											requiredSpecialization = "General";
										}
										// Iterate through available technicians to find a match
										for each  technician in availableTechnicians
										{
											// Check if technician specialization matches required specialization
											if(technician.specialization == requiredSpecialization)
											{
												matchedTechnician = technician;
												break;
											}
										}
										// If no match found with specialization, assign first available technician
										if(matchedTechnician == null && availableTechnicians.count() > 0)
										{
											matchedTechnician = availableTechnicians;
										}
										// Update the assigned_technician field with the matched technician's name
										if(matchedTechnician != null)
										{
											input.assigned_technician = matchedTechnician.technician_name.first_name + " " + matchedTechnician.technician_name.last_name;
										}
						)
					}
				}

			}
			validate_service_date as "Validate Service Date Before Submit"
			{
				type =  form
				form = service_request

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Check if preferred_service_date field is provided and not null
										if(input.preferred_service_date.isNull())
										{
											// Field is blank, allow submission or handle as needed
											// No action required for blank date
										}
										else
										{
											// Get the current date for comparison
											currentDate = today;
											// Compare preferred service date with current date
											if(input.preferred_service_date < currentDate)
											{
												// Display error message before canceling submission
												alert "Error: Preferred service date cannot be in the past. Please select a future date.";
												// Cancel the form submission
												cancel submit;
											}
										}
						)
					}
				}

			}
			notify_owner_repair_complete as "Notify Owner on Repair Completion"
			{
				type =  form
				form = service_request

				record event = on edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Check if repair status is changed to Completed
										if(input.repair_status == "Completed")
										{
											// Fetch owner name from the request
											ownerName = input.owner_name.first_name;
											ownerEmail = input.email_address;
											// Prepare email subject and message
											subject = "Your Vehicle Repair is Complete";
											message = "Dear " + ownerName + ",\n\nYour vehicle repair has been completed. Please contact us to pick up your vehicle.";
											// Send email to the owner
											sendmail
											[
												from :zoho.loginuserid
												to :ownerEmail
												subject :subject
												message :message
											]
										}
						)
					}
				}

			}
		}

		schedule
		{
			daily_bay_maintenance_reminder as "Daily Bay Maintenance Reminder"
			{
				type =  schedule
				form = service_bay
					status = inactive
				start = next_maintenance_date at "10:00:00"
				time zone = "Asia/Kolkata"
				on start
				{
					actions 
					{
					on load
					(
						// Get the next maintenance date from input
										nextMaintenanceDate = input.next_maintenance_date;
										// Get current date and time
										currentTime = zoho.currenttime;
										// Calculate days between current time and next maintenance date
										daysRemaining = currentTime.daysBetween(nextMaintenanceDate);
										// Check if maintenance is within 24 hours (less than 1 day)
										if(daysRemaining < 1)
										{
											// Prepare email subject
											subject = "Urgent: Vehicle Maintenance Due Soon";
											// Prepare email message
											message = "<p>Dear Maintenance Team,</p>";
											message = message.concat("<p>This is to inform you that the next maintenance for the service bay is scheduled within 24 hours.</p>");
											message = message.concat("<p><strong>Service Bay:</strong> " + input.bay_name + "</p>");
											message = message.concat("<p><strong>Next Maintenance Date:</strong> " + nextMaintenanceDate.toString() + "</p>");
											message = message.concat("<p>Please ensure all preparations are completed in time.</p>");
											// Send email to maintenance team
											sendmail
											[
												from :zoho.loginuserid
												to :"maintenance@company.com"
												subject :subject
												message :message
												content type :HTML
											]
										}
					)
					}
				}
			}
		}




