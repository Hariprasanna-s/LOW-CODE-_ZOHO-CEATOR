				permissions = {Chat:false, Predefined:false, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "Submit service requests with vehicle details and preferred service dates. \n"
				ModulePermissions
				{
					technician_profile
					{
						enabled= Viewall,Export 
						allFieldsVisible= true 
						ReportPermissions
						{
							technician_profile_by_specialization={"View"}
							technician_profile_Report={"View"}
						}
					}
					service_request
					{
						enabled= Create,Export,Tab 
						allFieldsVisible= true 
						ReportPermissions
						{
							service_request_Report={"View","Edit"}
							service_request_by_vehicle_type={"View","Edit"}
						}
					}
					service_bay
					{
						enabled= Viewall,Export 
						allFieldsVisible= true 
						ReportPermissions
						{
							service_bay_Report={"View"}
							service_bay_by_current_status={"View"}
						}
					}
				}
			}
			roles
			{
				"CEO"
				{
					description = "User belonging to this role can access data of all other users."
				}
			}
	}


